# --- 翻譯後端選擇 ---
# sakura = 本地 Ollama（免費，需先安裝 Ollama + SakuraLLM）
# claude = Anthropic API（需要 API key）
TRANSLATOR_BACKEND=sakura

# --- Anthropic API（TRANSLATOR_BACKEND=claude 時才需要）---
ANTHROPIC_API_KEY=your_api_key_here

# --- Ollama 設定（TRANSLATOR_BACKEND=sakura 時使用）---
OLLAMA_BASE_URL=http://localhost:11434/v1
SAKURA_MODEL=sakura
